        <domain includeSubdomains="true">kotlinconf.com</domain>
        <pin-set expiration="2027-06-01">
            <!-- Primary pin for kotlinconf.com (replace with actual SPKI SHA-256) -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <!-- Backup pin for kotlinconf.com (replace with actual SPKI SHA-256) -->
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
